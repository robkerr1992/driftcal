# DriftCal Configuration
# Copy to .env and fill in values: cp .env.example .env

# ── Required ──────────────────────────────────────────────

# Static Bearer token for REST API authentication
# Generate: openssl rand -hex 32
DRIFTCAL_API_KEY=

# Public URL for OAuth callbacks and webhook registration
# Example: https://driftcal.yourdomain.com
DRIFTCAL_BASE_URL=

# Nylas v3 calendar integration
# Get from: https://dashboard.nylas.com
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
NYLAS_WEBHOOK_SECRET=

# Claude API key for suggestion generation
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram bot configuration
# Create bot: https://t.me/BotFather
# Get user ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_ID=
# Generate: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# OpenWeather API key for weather context
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── Optional (with defaults) ─────────────────────────────

# Path to SQLite database file (default: ./driftcal.db)
# DRIFTCAL_DB_PATH=./driftcal.db

# HTTP server bind address (default: 0.0.0.0)
# DRIFTCAL_HOST=0.0.0.0

# HTTP server port (default: 8080)
# DRIFTCAL_PORT=8080

# Log level: debug, info, warn, error (default: info)
# DRIFTCAL_LOG_LEVEL=info
